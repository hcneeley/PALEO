# Local / Render environment (optional overrides)
ADAPTER_TIMEOUT_SEC=3.5
CACHE_TTL_SEC=86400
OCCURRENCE_LIMIT=50
HOST=0.0.0.0
PORT=8080
# Crossref polite pool (recommended): https://www.crossref.org/documentation/retrieve-metadata/rest-api/
CROSSREF_MAILTO=you@example.com
# OpenMindat — https://www.mindat.org/a/how_to_get_my_mindat_api_key
MINDAT_API_KEY=your_mindat_token_here
