# Local / Render environment (optional overrides)
ADAPTER_TIMEOUT_SEC=3.5
# Heavy upstreams (seconds); floor is still ADAPTER_TIMEOUT_SEC
ADAPTER_TIMEOUT_GBIF_SEC=25
ADAPTER_TIMEOUT_MINDAT_SEC=30
ADAPTER_TIMEOUT_NEOTOMA_SEC=25
ADAPTER_TIMEOUT_IDIGBIO_SEC=20
ADAPTER_TIMEOUT_MORPHOSOURCE_SEC=20
CACHE_TTL_SEC=86400
OCCURRENCE_LIMIT=50
HOST=0.0.0.0
PORT=8080
# Crossref polite pool (recommended): https://www.crossref.org/documentation/retrieve-metadata/rest-api/
CROSSREF_MAILTO=you@example.com
# OpenAlex — https://docs.openalex.org/ (mailto falls back to CROSSREF_MAILTO)
OPENALEX_MAILTO=you@example.com
# Optional: https://openalex.org/settings/api
# OPENALEX_API_KEY=
# OpenMindat — https://www.mindat.org/a/how_to_get_my_mindat_api_key
MINDAT_API_KEY=your_mindat_token_here
